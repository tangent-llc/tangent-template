#!/usr/bin/env coconut-run
"""
Scaffold a new project from tangent-template.

After "Use this template" on GitHub, run this to customize:
  - Project name in package.json, CLAUDE.md, configs
  - Supabase URL + keys in .env.local
  - Git remote setup
  - CLAUDE.md project-specific section
  - Optional: Mapbox token, custom domain

Usage:
    coconut-run scripts/scaffold.coco                          # Interactive
    coconut-run scripts/scaffold.coco --name myproject         # With project name
    coconut-run scripts/scaffold.coco --name myapp --supabase-url https://xyz.supabase.co
    coconut-run scripts/scaffold.coco --check                  # Verify scaffold was run

Idempotent: safe to run again (updates existing values).
"""

import sys
import os
import json
import re
import subprocess
from pathlib import Path
from typing import Dict, Optional, Tuple, List


def run_cmd(cmd: str, timeout: int = 15) -> Tuple[int, str, str]:
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return (r.returncode, r.stdout.strip(), r.stderr.strip())
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return (1, "", str(e))


def find_root() -> Path:
    code, stdout, _ = run_cmd("git rev-parse --show-toplevel")
    if code == 0 and stdout:
        return Path(stdout)
    p = Path.cwd()
    for parent in [p] + list(p.parents):
        if (parent / ".git").exists() or (parent / "package.json").exists():
            return parent
    return p


def read_json(path: Path) -> Optional[dict]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def write_json(path: Path, data: dict) -> None:
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def get_arg(args: list, flag: str) -> Optional[str]:
    """Get value of a --flag=value or --flag value argument."""
    for i, a in enumerate(args):
        if a == flag and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(f"{flag}="):
            return a.split("=", 1)[1]
    return None


def prompt_value(label: str, default: Optional[str] = None, required: bool = False) -> Optional[str]:
    """Prompt for a value with optional default."""
    suffix = f" [{default}]" if default else ""
    marker = " (required)" if required and not default else ""
    try:
        value = input(f"  {label}{marker}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return default
    return value if value else default


def infer_project_name(root: Path) -> str:
    """Try to infer project name from directory or package.json."""
    pkg = read_json(root / "package.json")
    if pkg and pkg.get("name") and pkg["name"] != "tangent-template":
        return pkg["name"]
    # Use directory name, excluding common suffixes
    name = root.name
    for suffix in ["-main", "-master", "-dev", "-template"]:
        if name.endswith(suffix):
            name = name[:-len(suffix)]
    return name


def update_package_json(root: Path, project_name: str) -> bool:
    """Update package.json with project name."""
    pkg_path = root / "package.json"
    pkg = read_json(pkg_path)
    if not pkg:
        return False

    changed = False
    if pkg.get("name") != project_name:
        pkg["name"] = project_name
        changed = True

    if pkg.get("description", "").startswith("Template") or not pkg.get("description"):
        pkg["description"] = f"{project_name} — built from tangent-template"
        changed = True

    # Remove template-specific fields
    for key in ["template", "is_template"]:
        if key in pkg:
            del pkg[key]
            changed = True

    if changed:
        write_json(pkg_path, pkg)
    return changed


def update_env(root: Path, values: Dict[str, str]) -> bool:
    """Create or update .env.local with provided values."""
    env_path = root / ".env.local"

    existing: Dict[str, str] = {}
    if env_path.exists():
        for line in env_path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, val = line.partition("=")
                existing[key.strip()] = val.strip()

    # Merge new values (new values take precedence)
    merged = {**existing, **values}

    # Write back with categories
    lines = [
        "# Auto-generated by scaffold.coco",
        "# Do NOT commit this file (should be in .gitignore)",
        "",
    ]

    # Group by prefix
    groups: Dict[str, List[Tuple[str, str]]] = {
        "Supabase": [],
        "Mapbox": [],
        "App": [],
        "Other": [],
    }

    for k, v in sorted(merged.items()):
        if "SUPABASE" in k.upper():
            groups["Supabase"].append((k, v))
        elif "MAPBOX" in k.upper():
            groups["Mapbox"].append((k, v))
        elif k.startswith("NEXT_PUBLIC_APP") or k == "NODE_ENV":
            groups["App"].append((k, v))
        else:
            groups["Other"].append((k, v))

    for group_name, entries in groups.items():
        if entries:
            lines.append(f"# --- {group_name} ---")
            for k, v in entries:
                lines.append(f"{k}={v}")
            lines.append("")

    env_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return True


def update_claude_md(root: Path, project_name: str, description: Optional[str] = None) -> bool:
    """Add project-specific section to CLAUDE.md."""
    claude_path = root / "CLAUDE.md"
    if not claude_path.exists():
        return False

    content = claude_path.read_text(encoding="utf-8")

    # Check if already customized
    if f"## Project: {project_name}" in content:
        return False

    # Replace the first line (template identity) with project identity
    first_line = content.split("\n")[0]
    if first_line.strip() == "# tangent-template":
        content = content.replace(
            "# tangent-template",
            f"# {project_name}",
            1
        )
        # Replace the description line
        content = content.replace(
            "Universal devcontainer foundation for all tangent-llc projects. Not a standalone application.",
            description or f"{project_name} — built from tangent-template.",
            1
        )

    # Add project section before "## Constraints" (or at end)
    project_section = f"""
## Project: {project_name}

{description or 'TODO: Add project description.'}

### Project-specific scripts

Add project scripts here as they're created.

### Project-specific constraints

Add constraints here (API rate limits, deployment targets, etc.).
"""

    if "## Constraints" in content:
        content = content.replace(
            "## Constraints",
            project_section.strip() + "\n\n## Constraints",
        )
    else:
        content = content.rstrip() + "\n\n" + project_section.strip() + "\n"

    claude_path.write_text(content, encoding="utf-8")
    return True


def update_eslint_config(root: Path, project_name: str) -> bool:
    """ESLint config is project-agnostic, no update needed."""
    return False


def check_scaffold(root: Path) -> int:
    """Verify scaffold was run correctly."""
    print(f"\n{'=' * 64}")
    print(f"  Scaffold Check")
    print(f"  Root: {root}")
    print(f"{'=' * 64}\n")

    checks = []

    # package.json customized
    pkg = read_json(root / "package.json")
    if pkg:
        name = pkg.get("name", "")
        if name == "tangent-template" or not name:
            checks.append(("[X]", "package.json", "still has template name"))
        else:
            checks.append(("[+]", "package.json", f"name: {name}"))
    else:
        checks.append(("[X]", "package.json", "missing"))

    # .env.local exists
    env_path = root / ".env.local"
    if env_path.exists():
        content = env_path.read_text(encoding="utf-8")
        has_placeholders = "your-" in content or "xxx" in content.lower()
        if has_placeholders:
            checks.append(("[~]", ".env.local", "exists but has placeholder values"))
        else:
            checks.append(("[+]", ".env.local", "configured"))
    else:
        checks.append(("[~]", ".env.local", "missing (run scaffold to create)"))

    # CLAUDE.md customized
    claude_path = root / "CLAUDE.md"
    if claude_path.exists():
        content = claude_path.read_text(encoding="utf-8")
        if content.startswith("# tangent-template"):
            checks.append(("[~]", "CLAUDE.md", "still has template identity"))
        else:
            checks.append(("[+]", "CLAUDE.md", "customized"))
    else:
        checks.append(("[X]", "CLAUDE.md", "missing"))

    # Pre-commit hook installed
    hook_path = root / ".git" / "hooks" / "pre-commit"
    if hook_path.exists():
        checks.append(("[+]", "pre-commit hook", "installed"))
    else:
        checks.append(("[~]", "pre-commit hook", "not installed (run precommit.coco --install)"))

    # Print results
    fails = sum(1 for s, _, _ in checks if s == "[X]")
    warns = sum(1 for s, _, _ in checks if s == "[~]")

    for symbol, name, detail in checks:
        print(f"  {symbol} {name}: {detail}")

    print()
    if fails > 0:
        print("  Run: coconut-run scripts/scaffold.coco")
    elif warns > 0:
        print("  Some items need attention (see above)")
    else:
        print("  [+] Scaffold complete")

    return 1 if fails > 0 else 0


def main(args: list) -> int:
    root = find_root()

    if "--check" in args:
        return check_scaffold(root)

    print(f"\n{'=' * 64}")
    print(f"  Scaffold New Project from tangent-template")
    print(f"  Root: {root}")
    print(f"{'=' * 64}\n")

    # Gather inputs (from args or interactive)
    project_name = get_arg(args, "--name") or prompt_value(
        "Project name",
        default=infer_project_name(root),
        required=True
    )

    if not project_name:
        print("[X] Project name is required")
        return 1

    description = get_arg(args, "--description") or prompt_value(
        "Short description",
        default=f"{project_name} — built from tangent-template"
    )

    supabase_url = get_arg(args, "--supabase-url") or prompt_value(
        "Supabase URL",
        default="https://your-project.supabase.co"
    )

    supabase_anon = get_arg(args, "--supabase-anon") or prompt_value(
        "Supabase anon key",
        default="your-anon-key-here"
    )

    mapbox_token = get_arg(args, "--mapbox-token") or prompt_value(
        "Mapbox token (optional)",
        default=""
    )

    app_url = get_arg(args, "--app-url") or prompt_value(
        "App URL",
        default="http://localhost:3000"
    )

    print(f"\n--- Scaffolding {project_name} ---\n")

    # Apply changes
    actions = []

    # 1. package.json
    if update_package_json(root, project_name):
        actions.append(("[+]", "package.json", f"name: {project_name}"))
    else:
        actions.append(("[~]", "package.json", "already set or missing"))

    # 2. .env.local
    env_values: Dict[str, str] = {
        "NEXT_PUBLIC_SUPABASE_URL": supabase_url or "",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": supabase_anon or "",
        "NEXT_PUBLIC_APP_URL": app_url or "http://localhost:3000",
        "NODE_ENV": "development",
    }
    if mapbox_token:
        env_values["NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN"] = mapbox_token

    if update_env(root, env_values):
        actions.append(("[+]", ".env.local", "created/updated"))

    # 3. CLAUDE.md
    if update_claude_md(root, project_name, description):
        actions.append(("[+]", "CLAUDE.md", f"customized for {project_name}"))
    else:
        actions.append(("[~]", "CLAUDE.md", "already customized or missing"))

    # 4. Pre-commit hook
    hook_path = root / ".git" / "hooks" / "pre-commit"
    if not hook_path.exists():
        # Auto-install pre-commit hook
        print("  Installing pre-commit hook...")
        code, _, _ = run_cmd(f'coconut-run "{root / "scripts" / "precommit.coco"}" --install')
        if code == 0:
            actions.append(("[+]", "pre-commit hook", "installed"))
        else:
            actions.append(("[~]", "pre-commit hook", "install failed (run precommit.coco --install manually)"))
    else:
        actions.append(("[~]", "pre-commit hook", "already installed"))

    # Print summary
    print(f"\n{'=' * 64}")
    print(f"  Scaffold Summary: {project_name}")
    print(f"{'=' * 64}\n")

    for symbol, name, detail in actions:
        print(f"  {symbol} {name}: {detail}")

    has_placeholders = any(
        v and ("your-" in v or "xxx" in v.lower())
        for v in env_values.values()
    )

    print()
    if has_placeholders:
        print("  [!] .env.local has placeholder values -- update with real keys")
        print(f"      Edit: {root / '.env.local'}")

    print(f"\n  Next: coconut-run scripts/scaffold.coco --check")
    print(f"        coconut-run scripts/health_check.coco")

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
