#!/usr/bin/env coconut-run
"""
Environment cleanup — remove redundant packages after Prettier+ESLint migration.

Phases:
  1. --pip         Remove redundant pip packages
  2. --winget      Remove redundant winget packages
  3. --verify      Check nothing broke
  4. --all         All phases in order

Usage:
    coconut-run scripts/env_cleanup.coco --all
    coconut-run scripts/env_cleanup.coco --pip
    coconut-run scripts/env_cleanup.coco --winget
    coconut-run scripts/env_cleanup.coco --verify
"""

import sys
import subprocess
from typing import Tuple

# --- Types ---

data Result(name: str, status: str, detail: str)


# --- Helpers ---

def run_cmd(cmd: str, timeout: int = 120) -> Tuple[int, str, str]:
    try:
        r = subprocess.run(
            cmd, shell=True, capture_output=True, text=True, timeout=timeout
        )
        return (r.returncode, r.stdout.strip(), r.stderr.strip())
    except FileNotFoundError:
        return (1, "", "command not found")
    except subprocess.TimeoutExpired:
        return (1, "", f"timeout after {timeout}s")


def print_result(r: Result) -> None:
    match r.status:
        case "ok":   print(f"  [+] {r.name}: {r.detail}")
        case "fail": print(f"  [X] {r.name}: {r.detail}")
        case "skip": print(f"  [-] {r.name}: {r.detail}")
        case "warn": print(f"  [!] {r.name}: {r.detail}")


def section(title: str) -> None:
    print(f"\n  --- {title} ---")


def pip_uninstall(pkg: str) -> Result:
    """Uninstall a pip package. Returns result."""
    # Check if installed first
    code, out, _ = run_cmd(f"pip show {pkg}", timeout=15)
    if code != 0:
        return Result(pkg, "skip", "not installed")
    r_code, r_out, r_err = run_cmd(f"pip uninstall -y {pkg}", timeout=30)
    if r_code == 0:
        return Result(pkg, "ok", "removed")
    else:
        return Result(pkg, "fail", (r_err or r_out).split("\n")[0][:80])


def winget_uninstall(name: str, pkg_id: str, extra: str = "") -> Result:
    """Uninstall a winget package."""
    cmd = f"winget uninstall {pkg_id} --accept-source-agreements"
    if extra:
        cmd += f" {extra}"
    code, out, err = run_cmd(cmd, timeout=120)
    if code == 0:
        return Result(name, "ok", "removed")
    else:
        combined = (out + " " + err).lower()
        if "no installed package" in combined or "not found" in combined:
            return Result(name, "skip", "not installed")
        else:
            return Result(name, "fail", (err or out).split("\n")[0][:80])


# ================================================================
#  PHASE 1: PIP CLEANUP
# ================================================================

def phase_pip() -> list:
    results: list = []

    print(f"\n{'='*64}")
    print("  pip Cleanup")
    print(f"{'='*64}")

    # --- Formatter graveyard (Ruff replaces all) ---
    section("Formatters replaced by Ruff (10 tools -> 1)")
    formatter_pkgs = [
        "black", "autopep8", "yapf", "isort",
        "flake8", "pycodestyle", "pyflakes", "mccabe",
        "pydocstyle", "snowballstemmer",
        "pylint", "astroid", "dill",
    ]
    for pkg in formatter_pkgs:
        r = pip_uninstall(pkg)
        results.append(r)
        print_result(r)

    # --- Scrapy + all transitive deps ---
    section("Scrapy stack (not used)")
    scrapy_pkgs = [
        "scrapy",
        "twisted", "automat", "constantly", "hyperlink", "incremental",
        "pydispatcher", "protego", "queuelib", "w3lib",
        "itemadapter", "itemloaders",
        "cssselect", "parsel",
        "zope.interface",
        "pyopenssl", "pysocks", "service-identity",
    ]
    for pkg in scrapy_pkgs:
        r = pip_uninstall(pkg)
        results.append(r)
        print_result(r)

    # --- python-lsp-server (Pylance covers it) ---
    section("python-lsp-server (Pylance replaces)")
    pylsp_pkgs = [
        "python-lsp-server", "python-lsp-jsonrpc",
        "rope", "whatthepatch", "pytoolconfig",
        "docstring-to-markdown",
    ]
    for pkg in pylsp_pkgs:
        r = pip_uninstall(pkg)
        results.append(r)
        print_result(r)

    # --- Misc dead weight ---
    section("Misc cleanup")
    misc_pkgs = [
        "powerline-status",   # starship/xonsh prompt replaces
        "commonmark",         # markdown-it-py replaces
        "xontrib-xlsd",      # needs lsd binary, not on Windows
        "libtmux",           # tmux API, useless on Windows
    ]
    for pkg in misc_pkgs:
        r = pip_uninstall(pkg)
        results.append(r)
        print_result(r)

    return results


# ================================================================
#  PHASE 2: WINGET CLEANUP
# ================================================================

def phase_winget() -> list:
    results: list = []

    print(f"\n{'='*64}")
    print("  winget Cleanup")
    print(f"{'='*64}")

    section("Redundant apps")

    # Postman -> posting (pip)
    r = winget_uninstall("Postman", "Postman.Postman")
    results.append(r)
    print_result(r)

    # GitHub Desktop -> gh CLI + git + VSCode
    r = winget_uninstall("GitHub Desktop", "GitHub.GitHubDesktop")
    results.append(r)
    print_result(r)

    # DBeaver -> harlequin (pip)
    r = winget_uninstall("DBeaver", "DBeaver.DBeaver.Community")
    results.append(r)
    print_result(r)

    # Old KeePass duplicate
    r = winget_uninstall("KeePass 2.57 (old)", "DominikReichl.KeePass", "--version 2.57.1")
    results.append(r)
    print_result(r)

    return results


# ================================================================
#  PHASE 3: VERIFY
# ================================================================

def phase_verify() -> list:
    results: list = []

    print(f"\n{'='*64}")
    print("  Post-Cleanup Verification")
    print(f"{'='*64}")

    # Check Ruff still works
    section("Ruff (replacement for removed formatters)")
    code, out, _ = run_cmd('python -c "import ruff; print(\'ruff importable\')"', timeout=10)
    # ruff is a VSCode extension + CLI, not typically importable — check CLI
    code2, out2, _ = run_cmd("ruff --version", timeout=10)
    if code2 == 0:
        results.append(Result("ruff CLI", "ok", out2))
    else:
        # Ruff might only be in VSCode, not on PATH — that's fine
        results.append(Result("ruff CLI", "skip", "not on PATH (VSCode extension handles it)"))
    print_result(results[-1])

    # Check nothing critical broke
    section("Core tools still working")
    critical = [
        ("coconut", "coconut --version"),
        ("xonsh", "xonsh --version"),
        ("ipython", "python -c \"import IPython; print(IPython.__version__)\""),
        ("rich", "python -c \"import rich; print(rich.__version__)\""),
        ("textual", "python -c \"import textual; print(textual.__version__)\""),
        ("pydantic", "python -c \"import pydantic; print(pydantic.__version__)\""),
        ("httpx", "python -c \"import httpx; print(httpx.__version__)\""),
        ("click", "python -c \"import click; print(click.__version__)\""),
        ("structlog", "python -c \"import structlog; print(structlog.__version__)\""),
        ("sqlite-utils", "python -c \"import sqlite_utils; print(sqlite_utils.__version__)\""),
        ("llm", "llm --version"),
    ]
    for name, cmd in critical:
        code, out, err = run_cmd(cmd, timeout=15)
        if code == 0:
            ver = (out or err).split("\n")[0][:60]
            results.append(Result(name, "ok", ver))
        else:
            results.append(Result(name, "fail", "broken after cleanup"))
        print_result(results[-1])

    # Check xontribs still load
    section("xontribs")
    xontribs_expected = [
        "xontrib-abbrevs", "xontrib-fzf-completions",
        "xontrib-jedi", "xontrib-readable-traceback", "xontrib-zoxide",
    ]
    for xt in xontribs_expected:
        code, _, _ = run_cmd(f"pip show {xt}", timeout=10)
        if code == 0:
            results.append(Result(xt, "ok", "present"))
        else:
            results.append(Result(xt, "fail", "missing"))
        print_result(results[-1])

    # Confirm removed packages are gone
    section("Confirming removals")
    should_be_gone = ["black", "pylint", "flake8", "scrapy", "twisted", "python-lsp-server"]
    for pkg in should_be_gone:
        code, _, _ = run_cmd(f"pip show {pkg}", timeout=10)
        if code != 0:
            results.append(Result(pkg, "ok", "confirmed removed"))
        else:
            results.append(Result(pkg, "warn", "still installed"))
        print_result(results[-1])

    # Final pip count
    section("Package count")
    code, out, _ = run_cmd("pip list")
    if code == 0:
        pkg_count = max(0, len(out.splitlines()) - 2)
        results.append(Result("pip packages", "ok", f"{pkg_count} total (was 188)"))
    print_result(results[-1])

    return results


# ================================================================
#  MAIN
# ================================================================

def print_summary(results: list) -> Tuple[int, int, int]:
    ok = sum(1 for r in results if r.status == "ok")
    skip = sum(1 for r in results if r.status == "skip")
    fail = sum(1 for r in results if r.status == "fail")
    warn = sum(1 for r in results if r.status == "warn")

    print(f"\n{'='*64}")
    print(f"  Results: {ok} removed / {skip} skipped / {warn} warn / {fail} fail")
    print(f"{'='*64}")

    if fail == 0 and warn == 0:
        print("\n  [+] Cleanup complete -- no issues")
    elif fail > 0:
        print(f"\n  [X] {fail} items need attention")
        for r in results:
            if r.status == "fail":
                print(f"      - {r.name}: {r.detail}")

    return (ok, warn, fail)


def main(args: list) -> int:
    all_results: list = []
    do_all = "--all" in args

    print(f"\n{'='*64}")
    print("  Environment Cleanup")
    print(f"  Python: {sys.version.split()[0]}")
    print(f"{'='*64}")

    if "--pip" in args or do_all:
        all_results.extend(phase_pip())

    if "--winget" in args or do_all:
        all_results.extend(phase_winget())

    if "--verify" in args or do_all:
        all_results.extend(phase_verify())

    if not any(a in args for a in ["--pip", "--winget", "--verify", "--all"]):
        print("\n  Usage:")
        print("    coconut-run scripts/env_cleanup.coco --pip      # remove redundant pip packages")
        print("    coconut-run scripts/env_cleanup.coco --winget   # remove redundant winget apps")
        print("    coconut-run scripts/env_cleanup.coco --verify   # check nothing broke")
        print("    coconut-run scripts/env_cleanup.coco --all      # all phases")
        return 0

    ok, warn, fail = print_summary(all_results)
    return 1 if fail > 0 else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
