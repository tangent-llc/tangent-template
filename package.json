{
  "name": "tangent-template",
  "version": "0.2.0",
  "private": true,
  "description": "Devcontainer template for Next.js + Bun + Tailwind + Supabase",
  "license": "MIT",
  "author": "Tangent",
  "engines": {
    "bun": "^1.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "bun eslint . --fix",
    "lint:check": "bun eslint .",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "type-check": "tsc --noEmit",
    "ci": "bun run format:check && bun run lint:check && bun run type-check",
    "fix": "bun run format && bun run lint",
    "prepare": "coconut-run scripts/precommit.coco --install || true"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.3.8",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "postcss": "^8.4.31",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
