{
  "version": "0.1.0",
  "configurations": [
    {
      "name": "Bun dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "console": "integratedTerminal",
      "program": "${file}",
      "justMyCode": true
    }
  ]
}
